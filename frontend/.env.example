# Base URL of the FastAPI backend. Leave as /api in development (Vite proxies it to 127.0.0.1:8000).
VITE_API_BASE=/api

# Optional: how often Live Device Mode polls the backend, in milliseconds.
VITE_LIVE_POLL_MS=2000

# Never put secret keys in this file. Anything prefixed VITE_ is visible in the browser bundle.
