# Copy to .env and edit. Never commit the real file.

# SQLite file for the prototype. PostgreSQL can replace it later (see README).
DATABASE_PATH=./filtravyn.db

# Allowed browser origins for CORS, comma separated.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shared secret the ESP32 (or MQTT bridge) sends as the X-Device-Key header.
# Telemetry ingest is refused until this is set. Generate your own long random value.
DEVICE_API_KEY=

# Pump control is OFF by default. When enabled, the dashboard still shows "pending" until the device acknowledges.
PUMP_CONTROL_ENABLED=0
# Secret required in the X-API-Key header for POST /api/device/pump.
ADMIN_API_KEY=
# Backend safety limits for pump commands.
PUMP_MIN_COMMAND_INTERVAL_S=5

# Diagnostics thresholds. Placeholders until calibrated. They mirror frontend/src/config/device.ts.
STALE_TIMEOUT_S=15
PUMP_STARTUP_DELAY_S=10
FLOW_MIN_LPM=0.2
TDS_WARN_HIGH_PPM=500
TEMP_MIN_C=5
TEMP_MAX_C=40

# Optional MQTT bridge. Leave MQTT_URL empty to disable.
# Example: mqtt://localhost:1883
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=filtravyn/+/telemetry
